// QtRO view contract for the Monero wallet — one app, the way every Monero wallet is one app:
// balances, send, receive and activity, plus the wallet management (create · restore · open ·
// close · change password · show seed) that Monero GUI keeps under Settings.
//
// The wallet password crosses ONLY as a SLOT argument and the seed and view key ONLY as SLOT
// return values. Never a PROP: a PROP is cached in the replica and broadcast to every connected
// replica, so a secret in one leaks by construction. `scripts/check-rep-passwords.py` in
// logos-workspace owns this rule and lists this surface under SECRET_SLOTS (a secret PROP is
// refused, the SLOTs below are permitted) — but it can only run once this repo is registered as
// a workspace submodule, and until then it reports this repo as SKIPPED. Do not read the rule
// as enforced today.
//
// Monero's password is a once-per-session UNLOCK for one wallet file, not a per-signature
// credential — there is no signature to approve, so there is no second surface to split it onto.
//
// Everything crosses as a JSON string. EMPTY means "not read yet", which the view renders as an
// em-dash — never as a zero, and never as the previous wallet's number.
class MoneroWalletUi
{
    PROP(QString lastError="" READONLY)
    PROP(bool dataLoading=false READONLY)
    // A wallet lifecycle job (open/create/restore/close/change password) is in flight.
    PROP(bool busy=false READONLY)
    // wallet_status(): { state, wallet, network, address, connected, synchronized,
    //                    walletHeight, daemonHeight, syncPercent, watchOnly, activeNetwork }
    PROP(QString statusJson="{}" READONLY)
    // { networks: [...], active }
    PROP(QString networksJson="{}" READONLY)
    // [{ name, network, label, viewOnly, restoreHeight, address }]
    PROP(QString walletsJson="[]" READONLY)
    PROP(QString nodeHealthJson="{}" READONLY)
    // { balance, unlocked, balanceXmr, unlockedXmr } in atomic-unit strings + XMR strings.
    PROP(QString balancesJson="" READONLY)
    // { address, subaddresses: [{ index, address, label }] }
    PROP(QString receiveJson="" READONLY)
    // { size, bits } — the QR module matrix, drawn as rectangles by the view. The design system
    // has no QR control, and the sandbox blocks data: URIs, so an Image cannot show one.
    // It encodes receiveUri, so it follows the selected subaddress and any requested amount.
    PROP(QString qrModulesJson="" READONLY)
    // Which subaddress the Receive tab is showing (0 = the account's primary address).
    PROP(int selectedSubaddress=0 READONLY)
    // The BIP-21-style payment URI for the selection: monero:<address>[?tx_amount=...].
    PROP(QString receiveUri="" READONLY)
    // The active network's node, with the RPC password redacted to hasPassword:
    // { url, username, hasPassword, proxy, proxyRequired, trusted, source, network }
    PROP(QString nodeConfigJson="{}" READONLY)
    // { rows: [...] } newest first, amounts as atomic strings + XMR strings.
    PROP(QString historyJson="" READONLY)
    // The lifecycle job in flight, "" when none. Answered by lastJobJson when it settles.
    PROP(QString pendingJobId="" READONLY)
    // { kind, state, error } of the last settled job — also what answers a monero.wallet.unlock.
    PROP(QString lastJobJson="" READONLY)
    // The send in flight, "" when none, and its status: { state, preview, txids, error }.
    PROP(QString sendRequestId="" READONLY)
    PROP(QString sendStatusJson="{}" READONLY)
    // Send-path errors only; the Send dialog is modal and lastError renders behind it.
    PROP(QString sendError="" READONLY)

    // refresh() does NOT clear lastError (it runs after a failed job, and from events).
    // clearAndRefresh() is the user-initiated one: it clears first.
    SLOT(void refresh())
    SLOT(void refreshHistory())
    SLOT(void clearAndRefresh())

    // ---- wallet management: the only SLOTs that may name a secret ----
    SLOT(void setActiveNetwork(QString network))
    SLOT(void openWallet(QString name, QString password))
    SLOT(void createWallet(QString name, QString password, QString label))
    SLOT(void restoreFromSeed(QString name, QString password, QString seed, int restoreHeight, QString label))
    SLOT(void restoreFromKeys(QString name, QString password, QString address, QString viewKey, QString spendKey, int restoreHeight, QString label))
    SLOT(void changePassword(QString oldPassword, QString newPassword))
    // Returned once for display, then dropped by the view. Never published, never logged.
    SLOT(QString revealSeed(QString password))
    SLOT(QString revealViewKey(QString password))
    SLOT(void closeWallet())
    // Point the active network at a different daemon. CUSTODIAN, and refused while a wallet is
    // open: wallet2 binds its daemon at init. Omit "password" to keep the stored one.
    SLOT(void saveNodeConfig(QString configJson))

    // ---- receiving ----
    SLOT(void createSubaddress(QString label))
    // Show this subaddress: moves the QR, the URI and the copy target.
    SLOT(void selectSubaddress(int index))
    // Fold an amount into the payment URI (empty clears it). Not a transfer — a request.
    SLOT(void setReceiveAmount(QString amountXmr))
    // Rename a subaddress, or clear the label with an empty string.
    SLOT(void setSubaddressLabel(int index, QString label))

    // ---- spending ----
    // Build for review. sendJson: { address, amountXmr, priority?, accountIndex? }
    SLOT(void prepareSend(QString sendJson))
    // Broadcast the previewed transaction. This is BROADCAST approval; the engine signed at build.
    SLOT(void confirmSend())
    SLOT(void cancelSend())
    SLOT(bool addressValid(QString address))
    SLOT(QString formatXmr(QString atomic))
}
